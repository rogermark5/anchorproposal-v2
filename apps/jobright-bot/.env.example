# Use the API directly on this Ubuntu machine. Do not append /backend here.
JOBRIGHT_API_URL=http://127.0.0.1:3001
# Generate this limited worker key in Job pool > Jobright bot. Never use your password.
JOBRIGHT_WORKER_KEY=
# For the visible login window, copy DISPLAY/XAUTHORITY from your Ubuntu desktop terminal.
DISPLAY=:0
# XAUTHORITY=/run/user/1000/gdm/Xauthority
# Optional: installed Chrome executable, otherwise Puppeteer's bundled browser is used.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
